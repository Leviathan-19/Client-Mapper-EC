{
  "expo": {
    "name": "ClientMapperEC",
    "slug": "ClientMapperEC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_clientmapper_purple.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_clientmapper_purple.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_clientmapper_purple.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.leviathan98.ClientMapperEC",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "262c5b24-359b-49a0-b0b3-9049274327e5"
      }
    },
    "owner": "leviathan98",
    "plugins": [
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ]
    ]
  }
}
