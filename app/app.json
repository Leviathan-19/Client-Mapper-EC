{
  "expo": {
    "name": "ClientMapperEC",
    "slug": "ClientMapperEC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_clientmapper_purple.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo_clientmapper_purple.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_clientmapper_purple.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.leviathan19.ClientMapperEC"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a3fbd7a4-7fd9-4461-8336-af52d835d371"
      }
    },
    "owner": "leviathan19",
    "plugins": [
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native"
    ]
  }
}
